class Principal {
    public static void main(String[] args) {
        System.out.println(1000);
    }
}

class Objeto {
    int teste;

    public int metodo(int a) {
        return teste+a;
    }
}

class B {
    public int Execucao(){
        Objeto umObj;
        int resp;

        umObj = new Objeto();
        resp = umObj.metodo(true);

        return resp;
    }
}